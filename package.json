{
  "name": "@causa/runtime-google",
  "version": "3.0.0",
  "description": "An extension to the Causa runtime SDK (`@causa/runtime`), providing Google-specific features.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causa-io/runtime-typescript-google.git"
  },
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing.js"
  },
  "files": [
    "dist/",
    "LICENSE.md",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings=ExperimentalWarning\" jest",
    "test:cov": "npm run test -- --coverage"
  },
  "dependencies": {
    "@causa/runtime": "^3.0.0",
    "@google-cloud/precise-date": "^5.2.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@google-cloud/spanner": "^8.11.0",
    "@google-cloud/tasks": "^7.0.0",
    "@grpc/grpc-js": "^1.14.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "passport-http-bearer": "^1.0.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node22": "^22.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/passport-http-bearer": "^1.0.42",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "jest-extended": "^7.0.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
